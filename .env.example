# Google Programmable Search / Custom Search JSON API
# Keep these server-side. Do not expose them as NEXT_PUBLIC_* variables.
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=

# Optional local override for canonical URLs, robots.txt, and sitemap.xml.
NEXT_PUBLIC_SITE_URL=https://googleworkspacegemini.vercel.app

# Add only after Google accepts the site into its Workspace referral/affiliate program.
# Use the unique, approved tracking URL from the program dashboard.
NEXT_PUBLIC_GOOGLE_WORKSPACE_REFERRAL_URL=
